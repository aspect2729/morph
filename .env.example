# Copy to .env on the server and edit.

# Your free domain, e.g. mymorph.duckdns.org (must point at the server's public IP)
DOMAIN=mymorph.duckdns.org

# Limits (sensible defaults for a 2-CPU / 12 GB Oracle Always Free server)
MORPH_MAX_UPLOAD_MB=100
MORPH_MAX_PAGES=300
MORPH_TTL_HOURS=2
MORPH_LIBRARY_DAYS=14
MORPH_WORKERS=2
MORPH_RATE_PER_MIN=60
MORPH_MEMORY=8g

